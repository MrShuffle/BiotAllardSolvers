// 2D Biot-Allard in the frequency domain, homogeneous medium
load "iovtk"
verbosity = 0;                  
string tag = "_v";

// Frequencies [Hz] and Ricker wavelet values in the frequency domain
real[int] A2(6);
complex[int] B2(6);
A2 = [-5, 2, 7, 20, 30, 50];
B2 = [0.105016332095494 - 0.821409152270607i,      
      0.118194891257643 + 0.0762214456021446i,     
      -0.666979250979181 + 1.37457709566949i,      
      4.54798435156748 - 2.50044866014367i,       
      -2.43765347925807 + 2.28883419314118i,       
      -0.0524986911748207 + 0.160830597299232i];   

// --- Domain definition, all dimensions are implicitly in meters
real H    = 1000;
int n1    = 250;
mesh Th   = square(n1, n1, [H*x, H*y]);

// Max mesh size near (x0, y0), labeled hmax
real x0   = 500, y0 = 500;
real eps  = 1e-10;
fespace Vh0(Th, P0);
Vh0 h     = hTriangle;
real hmax = 0;
int nb    = 0;
for (int k = 0; k < Th.nt; k++) {
    real x1  = Th[k][0].x, y1 = Th[k][0].y;
    real x2  = Th[k][1].x, y2 = Th[k][1].y;
    real x3  = Th[k][2].x, y3 = Th[k][2].y;
    real det = (x2 - x1)*(y3 - y1) - (x3 - x1)*(y2 - y1);
    real l2  = ((x0 - x1)*(y3 - y1) - (x3 - x1)*(y0 - y1)) / det;
    real l3  = ((x2 - x1)*(y0 - y1) - (x0 - x1)*(y2 - y1)) / det;
    real l1  = 1 - l2 - l3;
    if (min(l1, min(l2, l3)) > -eps) {
        hmax = max(hmax, h[][k]);
        nb++;
    }
}
real distribution = 1.5*hmax;
real w            = (2*pi*distribution);

// --- Absorbing layer
real dPML     = 200;        
real m        = 2;
real R        = 1e-3;
real sigmaMax = (m+1)*5800*log(1./R)/(2*dPML);    
real[int] leftDom  = [0, dPML];
real[int] rightDom = [H-dPML, H];
real[int] botDom   = [0, dPML];
real[int] topDom   = [H-dPML, H];


real om      = 2.0*pi*A2[0];
real om2     = om^2;
complex val  = B2[0];

func sigX  = (x >= leftDom[0] && x <= leftDom[1]) ? sigmaMax*((dPML-x)/(dPML))^m
           : ((x >= rightDom[0] && x <= rightDom[1]) ? sigmaMax*((x-H+dPML)/(dPML))^m : 0.);
func sigY  = (y >= botDom[0] && y <= botDom[1]) ? sigmaMax*((dPML-y)/(dPML))^m
           : ((y >= topDom[0] && y <= topDom[1]) ? sigmaMax*((y-H+dPML)/(dPML))^m : 0.);
func SX    = 1/(1+1i*sigX/om);
func SY    = 1/(1+1i*sigY/om);
func detJx = 1+1i*sigX/om;
func detJy = 1+1i*sigY/om;
func detJ  = detJx*detJy;
func detJ1 = detJx*detJy;

macro divPML(u1,u2) (SX*dx(u1) + SY*dy(u2))                               // Divergence
macro dotGradPML(p,q) (SX*dx(p)*SX*dx(q) + SY*dy(p)*SY*dy(q))             // Gradient
macro dotEpsPML(u1,u2,v1,v2) (SX*dx(u1)*SX*dx(v1) + SY*dy(u2)*SY*dy(v2)
    + (SY*dy(u1)+SX*dx(u2))*(SY*dy(v1)+SX*dx(v2))/2.)                     // Strain

// --- Finite element spaces
fespace Vh2u(Th, [P2,P2]);
fespace Vh2p(Th, [P1]);
Vh2u<complex> [ux,uy], [vx,vy], [uxk,uyk];
Vh2p<complex> pf, pfk, qf;
fespace VhPet(Th, P1);      // output

// --- Material parameters
real Vp           = 5800;                                                
real Vs           = 2410;                                                 
real phi          = 0.16;                                                 
real Darcy        = 9.869233e-13; real kappa = 1*Darcy; real k = 1*Darcy; 
real eta          = 1e-3;                                                 
real Kf           = 2.2e9;                                               
real rhof         = 1e3;                                                 
real rhos         = 2631;                                                
real rho          = rhos*(1-phi)+phi*rhof;                                
real mu0          = rho*Vs^2;
real lambda0      = rho*Vp^2-2*mu0;
real Ks           = 37e9;                                                 
real Kd           = 30e9;                                                 
real alpha        = 1-Kd/Ks;                                              
real c0           = (alpha-phi)/Ks +phi/Kf;
real ainf         = 1.5;                                                 
real Lambda       = sqrt(ainf*k*8/phi);                                   // Carcione's formula for Lambda
real mu           = mu0;
real lambda       = lambda0;

func real gaussian3(real t) {return (1./w)*exp(-((x - H/2)^2 + (y - H/2)^2)/(2*(distribution)^2));}; // Note the distribution was overwritten by accident in a previous edition of this code and set to 5


// Biot-JKD Permeability
func complex JKD(real oma) {
	return k/(sqrt(1-(4*1i*square(ainf*k)*rhof*oma)/(square(Lambda*phi)*eta))-(1i*ainf*k*rhof*oma)/(eta*phi));
}; // TODO precompute such that it is not evaluated every time
complex Bmob = JKD(om)/eta;

fespace Vhrho(Th, P1);
Vhrho<complex> L = alpha*alpha/c0;     

// --- Variational forms // TODO complete resturcture of code to avoid reassembly...
problem mechanics([ux,uy],[vx,vy]) = int2d(Th)(2.*mu*detJ*dotEpsPML(ux,uy,vx,vy))
	+int2d(Th)(lambda*detJ*divPML(ux,uy)*divPML(vx,vy))
	+int2d(Th)(L*detJ*divPML(ux,uy)*divPML(vx,vy))  // wav Div(vx,vy)
	-int2d(Th)(rho*om2*detJ*(ux*vx+uy*vy))
	+int2d(Th)(1i*om*om2*rhof^2*Bmob*detJ1*(ux*vx+uy*vy))
	-int2d(Th)(L*detJ*divPML(uxk,uyk)*divPML(vx,vy))                 
	-int2d(Th)(alpha*detJ*pfk*divPML(vx,vy))                          
	+int2d(Th)(1i*om*rhof*Bmob*detJ*pfk*divPML(vx,vy))                
	-int2d(Th,qforder=7)(1i*om*val*gaussian3(0)*w*vy*detJ)           
	+on(1,2,3,4,ux=0,uy=0);

problem flow(pf,qf) = int2d(Th)(c0*pf*qf*detJ)
	-int2d(Th)(1i/om*Bmob*detJ*dotGradPML(pf,qf))
	-int2d(Th)(1i*om*rhof*Bmob*detJ*divPML(ux,uy)*qf)                
	+int2d(Th)(alpha*detJ*divPML(ux,uy)*qf)                         
	+on(1,2,3,4,pf=0);


real tol          = 1e-6;   // Tolerance
complex error     = 1;
complex error2    = 1;
int maxIter       = 100;    // Maximum iterations
int iter          = 0;
bool stopDiverged = true;   // stop runs whose displacement norm grows by 1e6 

int nFreq = A2.n;
int[int] iterTable(nFreq);  // negative = not converged
string iterFile = "iterations_homog" + tag + ".txt";
{
    ofstream fout(iterFile);
    fout << "# L = alpha^2/c0" << endl;
    fout << "# alpha = " << alpha << ", c0 = " << c0 << ", tol = " << tol << ", maxIter = " << maxIter << endl;
    fout << "# status: 1 = converged, 0 = maxIter reached, -1 = stopped as diverging" << endl;
    fout << "# freqHz iterations status errU errP" << endl;
}

// --- Loop over frequencies
for (int ifreq = 0; ifreq < nFreq; ++ifreq) {
    om   = 2.0*pi*A2[ifreq];
    om2  = om^2;
    val  = B2[ifreq];
    Bmob = JKD(om)/eta;

    [uxk,uyk] = [0,0];
    pfk       = 0;
    error     = 1;
    error2    = 1;
    iter      = 0;
    int status  = 0;        // 1 converged, 0 maxIter, -1 diverging
    real normU1 = 0;        

    cout << "==== frequency " << A2[ifreq] << " Hz ====" << endl;

    while ((abs(real(error)) > tol || abs(real(error2)) > tol) && (iter < maxIter)) {
        mechanics;          
        flow;              

        error  = sqrt(int2d(Th)((abs(ux-uxk))^2+(abs(uy-uyk))^2))/ sqrt(int2d(Th)(abs(ux)^2+abs(uy)^2));
        error2 = sqrt(int2d(Th)((abs(pf-pfk))^2))/ sqrt(int2d(Th)((abs(pf))^2));
        iter++;
        cout << "Iteration " << iter << ", error = " << error << "error pressure " << error2
             << endl;

        if (stopDiverged) {
            real normU = ux[].l2;
            if (iter == 1) normU1 = normU;
            else if (normU != normU || normU > 1e6*normU1) {
                status = -1;
                cout << "  stopped: displacement norm grew by more than 1e6 (diverging)" << endl;
                break;
            }
        }

        pfk       = pf;
        [uxk,uyk] = [ux,uy];
    };


    if (status == 0 && abs(real(error)) <= tol && abs(real(error2)) <= tol) status = 1;
    if (status == 1) iterTable[ifreq] = iter;
    else             iterTable[ifreq] = -iter;
    cout << "  -> f = " << A2[ifreq] << " Hz: " << iter << " iterations, status = " << status << endl;
    {
        ofstream fout(iterFile, append);
        fout << A2[ifreq] << " " << iter << " " << status << " " << real(error) << " "
             << real(error2) << endl;
    }

    // Export solution to paraview 
    if (ifreq == 4) {
        savevtk("Biot30omogenousv2" + tag + ".vtu", Th,
                [real(ux), real(uy), 0], [imag(ux), imag(uy), 0], real(pf), imag(pf),
                dataname = "ReU ImU ReP ImP");
        VhPet reUx = real(ux), reUy = real(uy), imUx = imag(ux), imUy = imag(uy);
        VhPet reP  = real(pf), imP  = imag(pf);
        savevtk("Biot30omogenousv2_cell" + tag + ".vtu", Th,
                [reUx, reUy, 0], [imUx, imUy, 0], reP, imP,
                dataname = "ReU ImU ReP ImP");
    }
}

cout << endl << "Final number of iterations (negative = not converged):" << endl;
cout << "  freqHz  iterations" << endl;
for (int ifreq = 0; ifreq < nFreq; ++ifreq)
    cout << "  " << A2[ifreq] << "  " << iterTable[ifreq] << endl;
